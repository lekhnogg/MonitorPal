/* ========================================================================== */
/* Dark Theme Styling - dark_theme.qss                                        */
/* ========================================================================== */

/* --- Base Dark Theme Global Rules --- */
QWidget[darkTheme="true"] {
    background-color: #111827; /* Tailwind gray-900 */
    color: #d1d5db;            /* Tailwind gray-300 */
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 9pt;
}

QMainWindow[darkTheme="true"] {
    background-color: #111827;
    border: none;
}

QWidget#mainCentralWidget {
    background-color: #111827;
    border: none;
    padding: 0px;
    margin: 0px;
}

/* --- Platform Toolbar (#platformToolbar) --- */
QToolBar#platformToolbar {
    background-color: #1f2937; /* gray-800 */
    border: none;
    border-bottom: 1px solid #374151; /* gray-700 */
    spacing: 6px;
    padding: 4px 8px;
}

/* General labels in toolbar */
QToolBar#platformToolbar QLabel {
     color: #9ca3af; /* gray-400 */
     background-color: transparent;
}

QToolBar#platformToolbar QLabel[class="toolbarDescriptor"] {
    padding: 0 2px 0 5px;
}

/* Logo/Title Styling */
QWidget#toolbarLogoWidget {
    background-color: transparent;
}

QLabel#toolbarLogoIcon {
    background-color: transparent;
}

QToolBar#platformToolbar QLabel#toolbarLogoText {
    background-color: transparent;
    color: #f3f4f6; /* gray-100 */
    font-size: 14px;
    font-weight: 600; /* Semi-bold */
    padding-left: 0px;
}

QLabel[class="toolbarSummaryLabel"] { /* Used elsewhere too */
    background-color: #374151;
    color: #f3f4f6;
    font-weight: bold;
    padding: 2px 6px;
    border-radius: 3px;
    margin-right: 4px;
    min-width: 50px;
}

/* --- Platform Container and ComboBox Styling --- */
/* Container styling */
QWidget#platformContainer {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #1f2937, stop:1 #374151); /* gradient from dark to lighter */
    border: 1px solid #4b5563; /* gray-600 */
    border-radius: 8px;
    padding: 2px 4px;
}

QWidget#platformContainer:hover {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #2d3748, stop:1 #4b5563); /* lighter gradient on hover */
    border: 1px solid #6b7280; /* gray-500, lighter border on hover */
}

QWidget#platformContainer:focus-within {
    border: 1px solid #a78bfa; /* Purple border when focused */
}

/* Icon container styling */
QWidget#platformIconContainer {
    background-color: rgba(139, 92, 246, 0.2);
    border-radius: 6px;
    margin-right: 5px;
    padding: 4px; /* increased, even padding */
    min-width: 16px; /* ensure width consistency */
    min-height: 16px; /* ensure height consistency */
    qproperty-alignment: 'AlignCenter';
}

QWidget#platformContainer:hover QWidget#platformIconContainer {
    background-color: rgba(139, 92, 246, 0.25); /* slightly more visible on container hover */
}

/* Platform ComboBox Styling - consolidated and consistent approach */
QComboBox#platformComboBox {
    background-color: transparent;
    color: #f3f4f6;
    border: none;
    border-radius: 8px;
    padding: 4px 8px;
    min-height: 28px;
    font-weight: 600;
}

QComboBox#platformComboBox:hover {
    color: #ffffff;
}

QComboBox#platformComboBox:focus {
    /* No additional focus border as container handles it */
    outline: none;
}

/* Style for the drop-down arrow */
QComboBox#platformComboBox::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 16px;
    height: 16px;
}

QComboBox#platformComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left-width: 0px; /* remove separator */
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

/* Dropdown styling - more specific selectors first */
QComboBox#platformComboBox QAbstractItemView {
    background-color: #1f2937;
    border: 1px solid #4b5563;
    color: #f3f4f6;
    selection-background-color: rgba(139, 92, 246, 0.3); /* Purple selection to match theme */
    selection-color: #d8b4fe; /* lighter purple text */
    padding: 6px; /* more padding */
    margin-top: 8px; /* create a floating effect */
    outline: 0px;
    border-radius: 8px; /* more rounded corners */
}

/* General dropdown style for other ComboBoxes */
QComboBox QAbstractItemView {
    background-color: #1f2937;
    border: 1px solid #4b5563;
    color: #f3f4f6;
    selection-background-color: rgba(139, 92, 246, 0.3);
    selection-color: #d8b4fe;
    padding: 6px;
    margin-top: 8px;
    outline: 0px;
    border-radius: 8px;
}

/* Toolbar Tab Buttons Styling - consolidated active states */
QToolBar#platformToolbar QPushButton[class="toolbarTabButton"] {
    background-color: transparent;
    color: #9ca3af; /* gray-400 */
    border: none; /* Clean base state */
    padding: 6px 10px;
    margin-left: 2px;
    margin-right: 2px;
    font-weight: 500;
    min-height: 22px;
    border-radius: 6px 6px 0 0; /* Rounded top corners */
    border-bottom: 3px solid transparent; /* Consistent bottom border */
}

QToolBar#platformToolbar QPushButton[class="toolbarTabButton"]:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #e5e7eb; /* gray-200 */
}

/* Single selector for active state */
QToolBar#platformToolbar QPushButton[class="toolbarTabButton"][activeTab="true"] {
    background-color: #374151; /* gray-700 */
    color: #60a5fa; /* blue-400 */
    font-weight: 600;
    border-bottom: 3px solid #60a5fa;
}

QToolBar#platformToolbar QPushButton[class="toolbarTabButton"][activeTab="true"]:hover {
    background-color: #4b5563;
}

/* Theme Toggle Button Styling */
QPushButton#themeToggleButton {
    background-color: #374151;
    border: 1px solid #4b5563;
    border-radius: 15px; /* Circular */
    padding: 4px;
    min-width: 28px; max-width: 28px;
    min-height: 28px; max-height: 28px;
}
QPushButton#themeToggleButton:hover { background-color: #4b5563; }
QPushButton#themeToggleButton:pressed { background-color: #2d3748; }

/* --- General Input Widgets (Dark Theme) --- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #374151; /* gray-700 */
    color: #f3f4f6;
    border: 1px solid #4b5563; /* gray-600 */
    border-radius: 4px;
    padding: 3px 6px;
    min-height: 18px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #60a5fa; /* blue-400 */
    background-color: #4b5563;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: #2d3748; /* gray-750 */
    color: #718096;    /* gray-500 */
    border-color: #4a5568; /* gray-650 */
}
QLineEdit:read-only, QLineEdit[readOnly="true"] {
    background-color: #2d3748;
    color: #9ca3af;
    border-color: #4a5568;
}

/* SpinBox Arrows */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    height: 10px;
    border-left: 1px solid #4b5563;
    border-bottom: 1px solid #4b5563;
    border-top-right-radius: 4px;
    background-color: #374151;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover { background-color: #4b5563; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/icons/chevron-up.svg); width: 10px; height: 10px; /* Needs light arrow */ }
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    height: 10px;
    border-left: 1px solid #4b5563;
    border-top: 1px solid #4b5563;
    border-bottom-right-radius: 4px;
    background-color: #374151;
}
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background-color: #4b5563; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/icons/chevron-down.svg); width: 10px; height: 10px; /* Needs light arrow */ }

/* CheckBox */
QCheckBox { spacing: 5px; color: #d1d5db; }
QCheckBox::indicator { width: 14px; height: 14px; border-radius: 3px; border: 1px solid #4b5563; background-color: #374151; }
QCheckBox::indicator:hover { border: 1px solid #60a5fa; }
QCheckBox::indicator:checked { background-color: #3b82f6; border: 1px solid #2563eb; image: url(:/icons/check-light.svg); } /* check-light.svg assumed */
QCheckBox::indicator:disabled { background-color: #4b5563; border: 1px solid #556372; }
QCheckBox:disabled { color: #718096; }

/* --- Status Bar Styling (consolidated) --- */
QStatusBar {
    background-color: #1f2937;
    color: #9ca3af;
    border-top: 1px solid #374151;
    font-size: 9pt;
    padding: 3px 8px;
}

QStatusBar QLabel {
    padding: 1px 4px;
    border: none;
    min-height: 16px;
    background-color: transparent;
}

QLabel#statusBarMainStatusLabel {
    background-color: rgba(16, 185, 129, 0.2); /* green-900/20 */
    color: #4ade80; /* green-400 */
    border-radius: 4px;
    padding: 2px 8px;
    font-weight: 500;
    margin-right: 10px;
}

QLabel#statusBarRegionLabel {
    color: #60a5fa; /* blue-400 */
    text-decoration: underline;
    font-size: 9pt;
    margin: 0 3px;
}

QLabel#statusBarThresholdLabel {
    color: #f87171; /* red-400 */
    font-size: 9pt;
    margin: 0 3px;
}

QLabel#statusBarDurationLabel {
    color: #facc15; /* amber-400 */
    font-size: 9pt;
    margin: 0 3px;
}

QLabel#statusBarSeparator {
    color: #4b5563; /* gray-600 */
    font-weight: normal;
    padding: 0 5px;
    max-width: 10px;
}

QLabel#statusItemLabel {
    color: #9ca3af; /* gray-400 */
}

/* --- Neutral Panel Class Styling --- */
QFrame[class="statusInfoCard"], QFrame[class="contentSectionPanel"], QGroupBox[class="contentSectionPanel"] {
    background-color: #1f2937; /* gray-800 */
    border: 1px solid #374151; /* gray-700 */
    border-radius: 12px;
}
QLabel[class="panelTitle"] { font-size: 12px; font-weight: 500; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.05em; padding-bottom: 6px; }
QLabel[class="cardTitle"] { font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; color: #9ca3af; }

/* --- Dashboard Specific Widget Styling --- */
QFrame#pnlIconFrame { background-color: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px; }
QFrame#statusIconFrame { background-color: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 8px; }
QFrame#regionIconFrame { background-color: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.3); border-radius: 8px; }

QLabel#pnlDisplayLabel { font-size: 28px; font-weight: 700; letter-spacing: -0.025em; margin-top: 5px; }
QLabel#pnlDisplayLabel[state="positive"] { color: #4ade80; }
QLabel#pnlDisplayLabel[state="negative"] { color: #f87171; }
QLabel#pnlDisplayLabel[state="neutral"]  { color: #9ca3af; }

QLabel#monitoringStatusLabel { font-size: 28px; font-weight: 700; letter-spacing: -0.025em; margin-top: 5px; }
QLabel#monitoringStatusLabel[state="active"]   { color: #60a5fa; }
QLabel#monitoringStatusLabel[state="inactive"] { color: #9ca3af; }
QLabel#monitoringStatusLabel[state="error"]    { color: #f87171; }
QLabel#monitoringStatusLabel[state="busy"]     { color: #facc15; }

QLabel#regionNameLabel { font-size: 28px; font-weight: 700; color: #c084fc; letter-spacing: -0.025em; margin-top: 5px; }
QLabel#regionPositionLabel { font-size: 12px; color: #9ca3af; margin-top: 2px; }

QFrame#pnlChartPlaceholder { background-color: transparent; border: none; border-radius: 2px; }
QLabel#graphPlaceholder { background-color: transparent; border: none; border-radius: 6px; font-style: italic; color: #9ca3af; padding: 0px; text-align: center; /* qproperty-alignment: AlignCenter; */ }

QProgressBar#monitoringProgress, QProgressBar#vsCalibrationProgress { background-color: #374151; border: none; border-radius: 9999px; height: 8px; text-align: center; color: white; font-size: 7pt; }
QProgressBar#monitoringProgress::chunk, QProgressBar#vsCalibrationProgress::chunk { background-color: #3b82f6; border-radius: 9999px; }

QLabel#prereqBadge, QLabel#vsMonitorStatusBadge, QLabel#vsFlattenCountBadge { background-color: #374151; color: #d1d5db; border-radius: 6px; padding: 4px 10px; font-size: 10px; font-weight: 500; }
QLabel#alertsBadge { background-color: rgba(220, 38, 38, 0.15); color: #f87171; border: 1px solid rgba(220, 38, 38, 0.3); border-radius: 6px; padding: 4px 10px; font-size: 10px; font-weight: 500; }

QFrame#panelDivider { background-color: #374151; max-height: 1px; min-height: 1px; border: none; }

QFrame[objectName^="prereqRow_"] { border-radius: 6px; }
QFrame[objectName^="prereqRow_"]:hover { background-color: rgba(55, 65, 81, 0.3); }
QLabel[objectName^="prereqIcon_"] { background-color: transparent; }
QLabel[objectName^="prereqText_"] { font-size: 12px; color: #d1d5db; background-color: transparent; }

/* --- General Button Class Styling --- */
/* Base style for themed buttons */
QPushButton[class="action"], QPushButton[class="danger"], QPushButton[class="styled"],
QPushButton[class="warning"], QPushButton[class="secondary"] {
    border-radius: 8px;
    font-weight: 500;
    font-size: 12px;
    padding: 6px 12px;
    min-height: 14px;
}
/* ActionButton */
QPushButton[class="action"] { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(34,197,94,0.2), stop:1 rgba(5,150,105,0.2)); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }
QPushButton[class="action"]:hover { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(34,197,94,0.3), stop:1 rgba(5,150,105,0.3)); }
QPushButton[class="action"]:pressed { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(34,197,94,0.4), stop:1 rgba(5,150,105,0.4)); }
QPushButton[class="action"]:disabled { background-color: rgba(55, 65, 81, 0.3); color: #6b7280; border-color: #374151; }
/* DangerButton */
QPushButton[class="danger"] { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(239,68,68,0.2), stop:1 rgba(225,29,72,0.2)); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
QPushButton[class="danger"]:hover { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(239,68,68,0.3), stop:1 rgba(225,29,72,0.3)); }
QPushButton[class="danger"]:pressed { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(239,68,68,0.4), stop:1 rgba(225,29,72,0.4)); }
QPushButton[class="danger"]:disabled { background-color: rgba(55, 65, 81, 0.3); color: #6b7280; border-color: #374151; }
/* StyledButton (Primary/Blue) */
QPushButton[class="styled"] { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(59,130,246,0.2), stop:1 rgba(79,70,229,0.2)); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); }
QPushButton[class="styled"]:hover { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(59,130,246,0.3), stop:1 rgba(79,70,229,0.3)); }
QPushButton[class="styled"]:pressed { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(59,130,246,0.4), stop:1 rgba(79,70,229,0.4)); }
QPushButton[class="styled"]:disabled { background-color: rgba(55, 65, 81, 0.3); color: #6b7280; border-color: #374151; }
/* WarningButton */
QPushButton[class="warning"] { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(245,158,11,0.2), stop:1 rgba(217,119,6,0.2)); color: #fcd34d; border: 1px solid rgba(245, 158, 11, 0.3); }
QPushButton[class="warning"]:hover { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(245,158,11,0.3), stop:1 rgba(217,119,6,0.3)); }
QPushButton[class="warning"]:pressed { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(245,158,11,0.4), stop:1 rgba(217,119,6,0.4)); }
QPushButton[class="warning"]:disabled { background-color: rgba(55, 65, 81, 0.3); color: #6b7280; border-color: #374151; }
/* SecondaryButton */
QPushButton[class="secondary"] { background-color: rgba(75, 85, 99, 0.4); color: #cbd5e1; border: 1px solid rgba(75, 85, 99, 0.6); }
QPushButton[class="secondary"]:hover { background-color: rgba(75, 85, 99, 0.6); border-color: rgba(100, 116, 139, 0.7); }
QPushButton[class="secondary"]:pressed { background-color: rgba(55, 65, 81, 0.7); }
QPushButton[class="secondary"]:disabled { background-color: rgba(55, 65, 81, 0.3); color: #6b7280; border-color: #374151; }
/* IconButton */
QPushButton[class="iconButtonBare"] { background-color: transparent; border: 1px solid transparent; padding: 4px; border-radius: 4px; }
QPushButton[class="iconButtonBare"]:hover { background-color: rgba(128, 128, 128, 0.15); border-color: rgba(128, 128, 128, 0.3); }
QPushButton[class="iconButtonBare"]:pressed { background-color: rgba(128, 128, 128, 0.3); }

/* --- Fallback QPushButton MUST COME AFTER the specific class rules --- */
QPushButton { border: 1px solid #4b5563; border-radius: 4px; padding: 4px 12px; min-height: 14px; background-color: #374151; color: #f3f4f6; font-weight: normal; }
QPushButton:hover { background-color: #4b5563; }
QPushButton:pressed { background-color: #2d3748; }
QPushButton:disabled { background-color: #2d3748; color: #718096; border-color: #4a5568; }

/* --- List Widgets (Flatten Regions) --- */
QListWidget#vsFlattenListWidget { background-color: transparent; border: none; border-radius: 0px; }
QListWidget#vsFlattenListWidget::item { padding: 2px; border: none; background-color: transparent; }

/* --- Alerts List Styling --- */
QListWidget#alertsList {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 4px;
}

QListWidget#alertsList::item {
    background-color: transparent; /* Default background */
    border: 1px solid #374151;
    border-radius: 8px;
    padding: 8px;
    margin: 4px 0px;
    min-height: 20px;
}

/* Alert type specific styling */
QListWidget#alertsList::item[data="error"] {
    background-color: rgba(239, 68, 68, 0.1);  /* red-500/10 */
    border: 1px solid rgba(239, 68, 68, 0.3);   /* red-500/30 */
    color: #f87171;  /* red-400 */
}

QListWidget#alertsList::item[data="warning"] {
    background-color: rgba(245, 158, 11, 0.1);  /* amber-500/10 */
    border: 1px solid rgba(245, 158, 11, 0.3);   /* amber-500/30 */
    color: #fbbf24;  /* amber-400 */
}

QListWidget#alertsList::item[data="success"] {
    background-color: rgba(16, 185, 129, 0.1);  /* emerald-500/10 */
    border: 1px solid rgba(16, 185, 129, 0.3);   /* emerald-500/30 */
    color: #34d399;  /* emerald-400 */
}

QListWidget#alertsList::item[data="info"] {
    background-color: rgba(59, 130, 246, 0.1);  /* blue-500/10 */
    border: 1px solid rgba(59, 130, 246, 0.3);   /* blue-500/30 */
    color: #60a5fa;  /* blue-400 */
}

QListWidget#alertsList::item:selected {
    background-color: rgba(59, 130, 246, 0.2);
    border-color: #3b82f6;
}

QListWidget#alertsList::item:hover {
    background-color: rgba(255, 255, 255, 0.03);
}
/* --- Log Display --- */
QTextEdit#logDisplay { background-color: #030712; color: #9ca3af; border: 1px solid #1f2937; border-radius: 6px; font-family: "Consolas", "Menlo", "Courier New", monospace; font-size: 11px; padding: 8px; }

/* --- Settings View Specifics --- */
QLabel#verifyStatusLabel { font-weight: bold; padding: 3px 6px; border-radius: 4px; }
QLabel#verifyStatusLabel[state="verified"] { background-color: #166534; color: #bbf7d0; } /* green-800 bg, green-200 text */
QLabel#verifyStatusLabel[state="error"] { background-color: #991b1b; color: #fecaca; } /* red-800 bg, red-200 text */
QLabel#verifyStatusLabel[state="pending"], QLabel#verifyStatusLabel[state="verifying"] { background-color: #9a3412; color: #fed7aa; } /* orange-800 bg, orange-200 text */
QLabel#platformDisplayLabel { font-weight: bold; color: #cbd5e1; }
QLabel#dataDirLabel { color: #9ca3af; }

/* --- Visual Setup Specifics --- */
QLabel#vsMonitorPreviewLabel { background-color: #111827; border: 1px dashed #4b5563; color: #6b7280; border-radius: 4px; }
QLabel#vsMonitorCoordsLabel { color: #9ca3af; font-size: 8pt; }
QLabel#vsOcrSourceStatusLabel { font-style: italic; color: #9ca3af; }
QLabel#vsCalibrationStatusLabel { color: #9ca3af; }
QLabel#vsCalibrationStatusLabel[state="success"] { color: #4ade80; }
QLabel#vsCalibrationStatusLabel[state="error"] { color: #f87171; }
QLabel#vsCalibrationStatusLabel[state="busy"] { color: #facc15; }
QLabel#vsCalibrationStatusLabel[state="info"] { color: #9ca3af; }
QGroupBox#vsAdvancedOcrGroup { margin-top: 10px; }

/* --- Region Entry Widget Styling --- */
QFrame#regionEntryContainer { background-color: #2d3748; border: 1px solid #4b5563; border-radius: 6px; }
QWidget#regionEntryHeader { background-color: #374151; border-bottom: 1px solid #4b5563; }
QLabel#regionEntryName { color: #e5e7eb; font-weight: bold; }
QLabel#regionEntryCoords { color: #9ca3af; font-size: 8pt; }
QLabel#regionEntryPreview { background-color: #111827; border: 1px solid #4b5563; color: #6b7280; }

/* --- History View Specifics --- */
QTableWidget#historyTable { background-color: #1f2937; border: 1px solid #374151; color: #d1d5db; gridline-color: #374151; border-radius: 6px; }
QTableWidget#historyTable::item { padding: 4px; border-bottom: 1px solid #374151; }
QTableWidget#historyTable::item:selected { background-color: #3b82f6; color: white; }
QHeaderView::section { background-color: #374151; color: #9ca3af; padding: 4px; border: 1px solid #4b5563; font-weight: bold; }

/* --- Scrollbars --- */
QScrollBar:vertical { border: none; background: #1f2937; width: 8px; margin: 0px; }
QScrollBar::handle:vertical { background: #4b5563; min-height: 25px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; border: none; background: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QScrollBar:horizontal { border: none; background: #1f2937; height: 8px; margin: 0px; }
QScrollBar::handle:horizontal { background: #4b5563; min-width: 25px; border-radius: 4px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; border: none; background: none; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* --- Splitter --- */
QSplitter::handle { background-color: #374151; }
QSplitter::handle:horizontal { width: 5px; }
QSplitter::handle:vertical   { height: 5px; }

/* --- Tooltip --- */
QToolTip { border: 1px solid #4b5563; background-color: #111827; color: #f3f4f6; padding: 4px; border-radius: 4px; }

/* --- GroupBox / GroupHeader --- */
QGroupBox, GroupHeader { font-weight: 500; background-color: #1f2937; border: 1px solid #374151; border-radius: 8px; color: #d1d5db; margin-top: 15px; padding: 1px; }
QGroupBox::title, GroupHeader::title { subcontrol-origin: margin; subcontrol-position: top left; left: 15px; padding: 2px 8px; margin-top: -8px; background-color: #1f2937; color: #9ca3af; font-size: 12px; font-weight: 600; border-radius: 4px; }
QGroupBox::indicator, GroupHeader::indicator { width: 16px; height: 16px; margin-left: 8px; subcontrol-origin: margin; subcontrol-position: top right; right: 10px; top: 3px; }
QGroupBox::indicator:unchecked, GroupHeader::indicator:unchecked { image: url(:/icons/chevron-right.svg); } /* Needs light icon */
QGroupBox::indicator:checked, GroupHeader::indicator:checked   { image: url(:/icons/chevron-down.svg); } /* Needs light icon */
QGroupBox[class="contentSectionPanel"] { padding: 1px; }