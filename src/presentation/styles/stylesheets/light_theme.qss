QPushButton[class="action"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(34,197,94,0.1), stop:1 rgba(5,150,105,0.1));
    color: #10b981;
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: 12px;
    font-weight: 500;
    font-size: 12px;
    padding: 16px;
}
QPushButton[class="action"]:hover { ... }
QPushButton[class="action"]:disabled { ... }
*/


/* Button Containers and Circle Backgrounds are specific to a different button design - remove if not used */
/* QFrame#startButtonContainer, ... */
/* QFrame#startCircle, ... */

/* Icon Buttons (Small, circular, icon-only buttons) */
QPushButton[class="iconButton"] {
    background-color: transparent;
    border: none;
    border-radius: 20px; /* Make it circular if width/height are equal */
    padding: 4px;
}
QPushButton[class="iconButton"]:hover { background-color: rgba(0, 0, 0, 0.05); }
QPushButton[class="iconButton"]:pressed { background-color: rgba(0, 0, 0, 0.1); }


/* Chart Stats (Dashboard P&L Trend) */
QLabel[class="chartStatLabel"] { /* e.g., "Current", "High", "Low" text */
    font-size: 10px; /* text-xs */
    color: #6b7280;   /* text-gray-500 */
}
QLabel#currentValue, QLabel#highValue, QLabel#lowValue { /* The actual values */
    font-size: 20px;  /* text-xl */
    font-weight: bold;
    color: #1f2937;   /* text-gray-800, state overrides for currentValue */
}
QLabel#currentValue[trend="positive"] { color: #10b981; } /* text-green-500 */
QLabel#currentValue[trend="negative"] { color: #ef4444; } /* text-red-500 */


/* Time Period Buttons (Dashboard P&L Trend) */
QPushButton[class="timeButton"] {
    background-color: rgba(229, 231, 235, 0.6); /* bg-gray-200/60 */
    border: 1px solid #e5e7eb;            /* border-gray-200 */
    border-radius: 6px;                   /* rounded-md */
    color: #6b7280;                       /* text-gray-500 */
    font-size: 10px;                      /* text-xs */
    padding: 4px 8px;                     /* px-2 py-1 */
    min-height: 0;
}
QPushButton[class="timeButton"][active="true"] {
    background-color: rgba(59, 130, 246, 0.1); /* bg-blue-500/10 */
    border: 1px solid rgba(59, 130, 246, 0.3); /* border-blue-500/30 */
    color: #3b82f6;                            /* text-blue-500 or text-blue-600 */
}
QPushButton[class="timeButton"]:hover {
    /* color: #4b5563; */ /* Optional: hover:text-gray-600 */
    background-color: rgba(209, 213, 219, 0.8);
}


/* Alerts List (Dashboard) */
QListWidget#alertsList {
    background-color: transparent; /* Let parent panel background show */
    border: none; /* No border for the list widget itself */
    border-radius: 0px;
    /* alternate-background-color: #f9fafb; /* Not needed if items have full bg */
}
QListWidget#alertsList::item { /* Styling for each alert item */
    border-radius: 8px; /* rounded-lg */
    padding: 12px;      /* p-3 */
    margin: 6px 0px;   /* space-y-3 (approx, applied to item margin) */
    color: #4b5563;    /* Default text color inside item */
    /* Border and background are set based on alert type below */
}
/* Specific alert types - this requires Python to set a property on QListWidgetItem */
/* Example: item.setProperty("alertType", "error") */
QListWidget#alertsList::item[alertType="error"] {
    background-color: rgba(220, 38, 38, 0.05);  /* bg-red-100/50 */
    border: 1px solid rgba(220, 38, 38, 0.3); /* border-red-300/30 */
    /* You'd also need a left accent border if desired, harder with QListWidgetItem */
}
QListWidget#alertsList::item[alertType="warning"] {
    background-color: rgba(245, 158, 11, 0.05); /* bg-amber-100/50 */
    border: 1px solid rgba(245, 158, 11, 0.3);/* border-amber-300/30 */
}
QListWidget#alertsList::item[alertType="success"] {
    background-color: rgba(16, 185, 129, 0.05);/* bg-green-100/50 */
    border: 1px solid rgba(16, 185, 129, 0.3);/* border-green-300/30 */
}
QListWidget#alertsList::item[alertType="info"] {
    background-color: rgba(59, 130, 246, 0.05); /* bg-blue-100/50 */
    border: 1px solid rgba(59, 130, 246, 0.3); /* border-blue-300/30 */
}
/* Selection and hover can be generic or also type-aware */
QListWidget#alertsList::item:selected {
    background-color: #2563eb; /* A distinct selection color */
    color: #ffffff;
    border-color: #1d4ed8;
}
QListWidget#alertsList::item:hover {
    /* Subtle brightness decrease on hover */
    background-color: rgba(0, 0, 0, 0.02); /* Needs to be applied carefully over existing item bg */
}


/* Small Button and Link Button (General use) */
QPushButton[class="smallButton"] { /* e.g., Prereq "Go to Setup", "Configure All" type buttons */
    background-color: rgba(168, 85, 247, 0.1); /* bg-purple-500/10 */
    border: 1px solid rgba(168, 85, 247, 0.3); /* border-purple-500/30 */
    border-radius: 8px; /* rounded-lg */
    color: #8b5cf6;     /* text-purple-500 */
    font-size: 12px;    /* text-sm */
    font-weight: 500;   /* font-medium */
    padding: 8px 12px;  /* py-2 px-3 */
    min-height: 0;
}
QPushButton[class="smallButton"]:hover {
    background-color: rgba(168, 85, 247, 0.2); /* hover:bg-purple-500/20 */
}

QPushButton[class="linkButton"] { /* If used */
    background-color: transparent;
    border: none;
    color: #3b82f6; /* text-blue-500 */
    font-size: 12px;
    text-align: center;
    padding: 4px;
}
QPushButton[class="linkButton"]:hover {
    color: #2563eb; /* Darker blue */
    text-decoration: underline;
}

/* Log Display (Dashboard) */
QTextEdit#logDisplay {
    background-color: #ffffff; /* e.g., white or almost white like bg-gray-50 in React example */
    color: #6b7280;           /* text-gray-500 or text-gray-600 */
    border: 1px solid #e5e7eb; /* Border like gray-200 */
    border-radius: 6px;        /* rounded */
    font-family: "Consolas", "Menlo", "Courier New", monospace; /* font-mono */
    font-size: 11px;           /* text-xs */
    padding: 8px;
}


/* Statistics Labels (Dashboard - if used) */
QLabel[class="statsLabel"] {
    font-size: 10px;
    color: #6b7280;
}
QLabel#sessionValue, QLabel#scansValue {
    font-size: 14px;
    font-weight: bold;
    color: #4b5563;
}

/* Graph Placeholder (Dashboard P&L Trend) */
QLabel#graphPlaceholder { /* The main P&L chart area */
    background-color: transparent; /* Chart itself will have background/gradients */
    border: none; /* No border if chart fills it */
    /* border: 1px dashed #d1d5db; /* Optional placeholder border */
    border-radius: 6px;
    font-style: italic;
    color: #6b7280;
    padding: 0px; /* Chart should manage its own margins */
    text-align: center; /* qproperty-alignment: AlignCenter; */
}

/* --- Scrollbars (Light Theme) --- */
QScrollBar:vertical {
    border: none; background: #f3f4f6; width: 8px; margin: 0px;
}
QScrollBar::handle:vertical {
    background: #d1d5db; min-height: 25px; border-radius: 4px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    border: none; background: #f3f4f6; height: 8px; margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #d1d5db; min-width: 25px; border-radius: 4px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }


/* --- Splitter --- */
QSplitter::handle {
    background-color: #e5e7eb;
}
QSplitter::handle:horizontal { width: 5px; }
QSplitter::handle:vertical   { height: 5px; }

/* --- Tooltip --- */
QToolTip {
    border: 1px solid #d1d5db;          /* (e.g., gray-300) */
    background-color: #ffffff;        /* Base light (e.g., white) */
    color: #1f2937;                   /* Dark text (e.g., gray-800) */
    padding: 6px 8px;
    border-radius: 6px;               /* rounded-md */
    /* opacity: 240; */ /* Qt usually handles this well, but can be set */
}

/* --- GroupBox (Light Theme) --- */
/* This is for general QGroupBoxes if you use them outside specific panels */
QGroupBox {
    font-weight: 500; /* Medium */
    border: 1px solid #e5e7eb; /* (e.g., gray-200) */
    border-radius: 12px;       /* rounded-xl */
    margin-top: 20px;          /* Space for title */
    background-color: #f9fafb; /* (e.g., gray-50) */
    padding: 12px;             /* p-3 or p-4 */
    padding-top: 25px;         /* More to clear title */
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 15px;
    padding: 2px 8px;
    background-color: #f9fafb; /* Match groupbox background */
    color: #6b7280;            /* (e.g., gray-500) */
    font-size: 12px;           /* text-sm */
    font-weight: 600;          /* font-semibold */
    border-radius: 4px;        /* Optional rounding for title bg */
}
QGroupBox::indicator {
     width: 16px; height: 16px; margin-left: 8px;
}
QGroupBox::indicator:unchecked { image: url(:/icons/chevron-right-dark.svg); } /* Dark chevron */
QGroupBox::indicator:checked   { image: url(:/icons/chevron-down-dark.svg); }  /* Dark chevron */

/* --- Theme Toggle Button (specific object name) --- */
QPushButton#themeToggleButton {
    background-color: transparent;
    border: none;
    padding: 2px;
}
QPushButton#themeToggleButton:hover {
    background-color: rgba(0, 0, 0, 0.05); /* Subtle dark hover */
}
QPushButton#themeToggleButton:pressed {
    background-color: rgba(0, 0, 0, 0.1); /* Darker press */
}