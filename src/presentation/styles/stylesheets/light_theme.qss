/* ========================================================================== */
/* Light Theme Styling - light_theme.qss                                        */
/* ========================================================================== */

/* --- Base Light Theme Global Rules --- */
QWidget[lightTheme="true"] { /* Applies to views like MainView, DashboardView if property set */
    background-color: #ffffff; /* Very light base background */
    color: #4b5563;            /* Default dark text color (e.g., Tailwind gray-600) */
    font-family: "Segoe UI", Arial, sans-serif; /* Ensure consistent font */
    font-size: 9pt;
}

QMainWindow[lightTheme="true"] { /* If MainView itself has lightTheme=true */
    background-color: #ffffff;
    border: none;
}

QWidget#mainCentralWidget { /* Main content area of the QMainWindow */
    background-color: #ffffff; /* Match QWidget[lightTheme="true"] */
    border: none;
    padding: 0px;
    margin: 0px;
}

/* --- Platform Toolbar (#platformToolbar) --- */
QToolBar#platformToolbar {
    background-color: #f3f4f6; /* Light panel color (e.g., gray-100) */
    border: none;
    border-bottom: 1px solid #e5e7eb; /* Separator (e.g., gray-200) */
    spacing: 8px;
    padding: 3px 8px;
}

QToolBar#platformToolbar QLabel {
     color: #6b7280; /* Muted text (e.g., gray-500) */
     background-color: transparent;
}
QToolBar#platformToolbar QLabel[class="toolbarDescriptor"] {
    padding: 0 2px 0 5px;
}
QToolBar#platformToolbar QLabel[class="toolbarSummaryLabel"] {
    background-color: #e5e7eb; /* Slightly darker panel (e.g., gray-200) */
    color: #1f2937; /* Dark text (e.g., gray-800) */
    font-weight: bold;
    padding: 2px 6px;
    border-radius: 3px;
    margin-right: 4px;
    min-width: 50px;
}

QToolBar#platformToolbar QComboBox#platformComboBox {
     background-color: #ffffff;
     color: #1f2937;
     border: 1px solid #d1d5db; /* (e.g., gray-300) */
     border-radius: 4px;
     padding: 3px 6px;
     min-height: 18px;
}
QToolBar#platformToolbar QComboBox#platformComboBox::drop-down {
    border-left: 1px solid #d1d5db;
    subcontrol-origin: padding; subcontrol-position: top right;
    width: 18px; border-top-right-radius: 3px; border-bottom-right-radius: 3px;
}
QToolBar#platformToolbar QComboBox#platformComboBox::down-arrow {
    image: url(:/icons/chevron-down-dark.svg); /* Dark chevron for light bg */
    width: 12px; height: 12px;
}

/* General Input Widgets (Light Theme) */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #ffffff; /* White background */
    color: #1f2937;
    border: 1px solid #d1d5db; /* (e.g., gray-300) */
    border-radius: 4px;
    padding: 3px 6px;
    min-height: 18px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #3b82f6; /* (e.g., blue-500) for focus */
    background-color: #f9fafb; /* Slightly darker focus bg (e.g., gray-50) */
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: #f3f4f6; /* Lighter disabled (e.g., gray-100) */
    color: #9ca3af;    /* More muted text (e.g., gray-400) */
    border-color: #e5e7eb; /* (e.g., gray-200) */
}

/* Combobox Dropdown List */
QComboBox QAbstractItemView {
    background-color: #ffffff; /* Light panel background */
    border: 1px solid #d1d5db; /* Light border */
    color: #1f2937; /* Dark text */
    selection-background-color: #3b82f6; /* Accent blue for selection */
    selection-color: white;
    padding: 4px;
    outline: 0px;
}

/* --- Tab Bar (#mainTabWidget) --- */
QTabWidget#mainTabWidget::pane {
    background-color: #ffffff; /* Base light background */
    border: 1px solid #e5e7eb; /* Light border around content area */
    border-top-style: none;
    border-radius: 4px;
    padding: 0px;
}

QTabWidget#mainTabWidget QTabBar::tab {
    background-color: #f3f4f6; /* Light inactive tab */
    color: #6b7280; /* Gray inactive text */
    border: 1px solid #e5e7eb; /* Light border */
    border-bottom-style: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 12px;
    min-width: 100px;
    font-weight: normal;
}
QTabWidget#mainTabWidget QTabBar::tab:hover {
    background-color: #e5e7eb; /* Darker gray on hover */
    color: #4b5563;
}
QTabWidget#mainTabWidget QTabBar::tab:selected {
    background-color: #ffffff; /* Selected tab matches pane background */
    color: #2563eb; /* Dark blue selected text */
    border: 1px solid #e5e7eb; /* Maintain other borders */
    border-bottom-style: none; /* "Opens" into the pane */
    /* border-top-color: #2563eb; */ /* Optional: Accent top border of selected tab */
    font-weight: bold;
}
QTabWidget#mainTabWidget QTabBar::tab:selected:hover {
    background-color: #f9fafb; /* Slightly different background on hover */
}


/* --- Status Bar --- */
QStatusBar {
    background-color: #f3f4f6; /* Match toolbar background */
    color: #6b7280; /* Default text color */
    border-top: 1px solid #e5e7eb; /* Light top border */
    font-size: 9pt;
}
QStatusBar QLabel#statusBarLabel {
    padding: 2px 8px;
    margin-left: 5px;
    border-radius: 3px;
    color: #6b7280; /* Default text color */
    background-color: transparent;
}


/* ========================================================================== */
/* --- NEW: Neutral Panel Class Styling (Light Theme) ---                      */
/* ========================================================================== */

/* For top status cards in DashboardView */
QFrame[class="statusInfoCard"] {
    background-color: #f9fafb; /* (e.g., gray-50) */
    border: 1px solid #e5e7eb; /* (e.g., gray-200) */
    border-radius: 12px;        /* Tailwind rounded-xl is often 0.75rem = 12px */
    /* Consider adding padding here if not set by internal layouts,
       or ensure internal layouts have appropriate margins. */
    /* padding: 15px; */ /* Example if needed */
}

/* For main section panels in DashboardView and other views */
QFrame[class="contentSectionPanel"] {
    background-color: #f9fafb; /* (e.g., gray-50) */
    border: 1px solid #e5e7eb; /* (e.g., gray-200) */
    border-radius: 12px;
    /* padding: 15px; */ /* Example if needed */
}

/* --- REMOVE OLD class="darkPanel" rule --- */
/* QFrame[class="darkPanel"] { ... } */


/* Panel Headers (These are fine, describe roles) */
QLabel[class="panelTitle"] {
    font-size: 14px; /* Or adjust to match React example (e.g., text-xs font-medium uppercase tracking-wider) */
    font-weight: 500; /* Medium weight */
    color: #6b7280;  /* Darker gray for titles (e.g. gray-500) */
    text-transform: uppercase;
    letter-spacing: 0.05em; /* Simulates tracking-wider */
    padding-bottom: 6px;
}

QLabel[class="cardTitle"] { /* For smaller titles like "Current P&L" */
    font-size: 11px; /* text-xs */
    font-weight: 500; /* font-medium */
    text-transform: uppercase;
    letter-spacing: 0.05em; /* tracking-wider */
    color: #6b7280; /* text-gray-500 */
}


/* ========================================================================== */
/* --- Dashboard Specific Widget Styling (Light Theme) ---                   */
/* ========================================================================== */

/* Icon Frames for Dashboard Cards (matching React example's small icon containers) */
/* These are very specific, targeted by objectName */
QFrame#pnlIconFrame { /* Example: trending-up icon */
    background-color: rgba(16, 185, 129, 0.1); /* bg-green-100/70 (approx) */
    border: 1px solid rgba(16, 185, 129, 0.3);  /* border-green-300/70 (approx) */
    border-radius: 8px; /* rounded-lg */
    /* Ensure fixed size in Python code for these to make them circular/square */
}
QFrame#statusIconFrame { /* Example: activity icon */
    background-color: rgba(59, 130, 246, 0.1); /* bg-blue-100/70 */
    border: 1px solid rgba(59, 130, 246, 0.3);  /* border-blue-300/70 */
    border-radius: 8px;
}
QFrame#regionIconFrame { /* Example: monitor icon for Region Card */
    background-color: rgba(168, 85, 247, 0.1); /* bg-purple-100/70 */
    border: 1px solid rgba(168, 85, 247, 0.3);  /* border-purple-300/70 */
    border-radius: 8px;
}
/* Add QFrame#ocrIconFrame if you have one, using similar logic */
/* QFrame#ocrIconFrame {
    background-color: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 8px;
} */


/* Card Values (Dashboard) */
QLabel#pnlDisplayLabel { /* e.g., +$74.85 */
    font-size: 28px;  /* text-3xl */
    font-weight: 700; /* font-bold */
    /* color: #4ade80; /* text-green-400 - state will override */
    letter-spacing: -0.025em; /* tracking-tight */
    margin-top: 5px;
}
QLabel#pnlDisplayLabel[state="positive"] { color: #10b981; } /* (e.g. green-500) */
QLabel#pnlDisplayLabel[state="negative"] { color: #ef4444; } /* (e.g. red-500) */
QLabel#pnlDisplayLabel[state="neutral"]  { color: #6b7280; } /* (e.g. gray-500) */

QLabel#monitoringStatusLabel { /* e.g., Active */
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-top: 5px;
}
QLabel#monitoringStatusLabel[state="active"]   { color: #3b82f6; } /* (e.g. blue-500) */
QLabel#monitoringStatusLabel[state="inactive"] { color: #6b7280; }
QLabel#monitoringStatusLabel[state="error"]    { color: #ef4444; }
QLabel#monitoringStatusLabel[state="busy"]     { color: #f59e0b; } /* (e.g. amber-500) */

QLabel#regionNameLabel { /* e.g., Region 3 */
    font-size: 28px;
    font-weight: 700;
    color: #8b5cf6; /* (e.g. purple-500) */
    letter-spacing: -0.025em;
    margin-top: 5px;
}
QLabel#regionPositionLabel { /* e.g., P&L Bottom Right */
    font-size: 12px; /* text-sm */
    color: #6b7280; /* text-gray-500 */
    margin-top: 2px; /* Reduced margin */
}

/* Chart placeholder (Dashboard P&L Card) */
QFrame#pnlChartPlaceholder { /* This is the small area chart in P&L card */
    background-color: transparent; /* Area chart itself has gradient */
    border: none;
    border-radius: 2px;
    /* min-height: 40px; */ /* h-10 in React */
}

/* Progress Bar (Dashboard Monitoring Status Card) */
QProgressBar#monitoringProgress { /* This ID seems not used in provided DashboardView */
    background-color: #e5e7eb; /* bg-gray-200 */
    border: none;
    border-radius: 9999px; /* rounded-full */
    height: 6px; /* h-1.5 in React */
    text-align: center;
    color: transparent; /* Hide text if it's just a visual bar */
}
QProgressBar#monitoringProgress::chunk {
    background-color: #3b82f6; /* bg-blue-500 */
    border-radius: 9999px; /* rounded-full */
}

/* Accuracy dots (If still used) */
QFrame[objectName^="accuracyDot_"] {
    background-color: #9ca3af; /* (e.g. gray-400) */
    border-radius: 3px;
    min-width: 6px; max-width: 6px;
    min-height: 6px; max-height: 6px;
}
QFrame[objectName^="accuracyDot_"][active="true"] {
    background-color: #8b5cf6; /* (e.g. violet-500) */
}

/* Badges (Dashboard Prerequisites, Alerts) */
QLabel#prereqBadge { /* e.g. "4/6 Complete" */
    background-color: #f3f4f6; /* bg-gray-100 */
    color: #4b5563;   /* text-gray-600 */
    border-radius: 6px; /* rounded-md */
    padding: 4px 10px; /* px-2.5 py-1 */
    font-size: 10px;   /* text-xs */
    font-weight: 500;
}
QLabel#alertsBadge { /* e.g. "1 Critical" */
    background-color: rgba(220, 38, 38, 0.1); /* bg-red-100/70 (approx) */
    color: #ef4444;                          /* text-red-500 */
    border: 1px solid rgba(220, 38, 38, 0.3); /* border-red-300/70 (approx) */
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 10px;
    font-weight: 500;
}

/* Panel Dividers (Dashboard) */
QFrame#panelDivider {
    background-color: #e5e7eb; /* (e.g. gray-200 or gray-200/50) */
    max-height: 1px;
    min-height: 1px;
    border: none;
}

/* Prerequisite Rows (Dashboard) */
QFrame[objectName^="prereqRow_"] {
    border-radius: 6px;
    /* No background, relies on parent panel background */
    /* padding: 8px 0; */ /* py-2 equivalent */
}
QFrame[objectName^="prereqRow_"]:hover {
    background-color: rgba(229, 231, 235, 0.6); /* Subtle hover, like gray-200/60 */
}

QLabel[objectName^="prereqText_"] { /* e.g. "Monitor Region" */
    font-size: 12px; /* text-sm */
    color: #4b5563;  /* text-gray-600 */
}
/* QLabel[objectName^="prereqStatus_"] { ... } /* If you have a separate status part */

/* Quick Action Button Styling */
/* These styles aim to mimic the larger, icon-focused buttons from the React example.
   The icon and text layout (icon above text) is NOT achieved by default with QPushButton.
   These styles focus on color, border, and size.
   If the icon-above-text layout is crucial, you need custom button widgets.
*/

/* Base for Action, Danger, Styled buttons on Dashboard if they follow the React example's large format */
QPushButton[class="action"],
QPushButton[class="danger"],
QPushButton[class="styled"] {
    border-radius: 12px; /* rounded-xl */
    font-weight: 500;    /* font-medium */
    font-size: 12px;     /* text-sm for the label part */
    padding: 16px;       /* p-4, makes button quite large for icon + text */
    min-width: 100px;    /* Ensure they have some width */
    /* For icon and text layout: default is icon left of text.
       To get icon above text in a standard QPushButton, you'd need:
       qproperty-toolButtonStyle: ToolButtonTextUnderIcon;
       And set a larger icon size. This often looks best with QToolButton.
       For QPushButton, you'd usually make a custom widget.
    */
}

/* "Start" button */
QPushButton[class="action"]#startButton { /* More specific if only startButton looks like this */
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(34,197,94,0.1), stop:1 rgba(5,150,105,0.1)); /* from-green-500/10 to-emerald-600/10 */
    color: #10b981;                           /* text-green-500 */
    border: 1px solid rgba(34, 197, 94, 0.3); /* border-green-500/30 */
    padding-top: 5px;     /* Reduce top padding */
    padding-bottom: 5px;  /* Reduce bottom padding */
    padding-left: 12px;   /* Keep or adjust horizontal padding */
    padding-right: 12px;

    min-height: 14px;     /* Example: A common "thinner" button height. Adjust as needed. */
}
QPushButton[class="action"]#startButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(34,197,94,0.2), stop:1 rgba(5,150,105,0.2));
}
QPushButton[class="action"]#startButton:disabled {
    background-color: rgba(229, 231, 235, 0.5); /* bg-gray-200/50 */
    color: #9ca3af;                          /* text-gray-400 */
    border-color: #e5e7eb;                   /* border-gray-200 */
}

/* "Stop" button */
QPushButton[class="danger"]#stopButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(239,68,68,0.1), stop:1 rgba(225,29,72,0.1)); /* from-red-500/10 to-rose-600/10 */
    color: #ef4444;                          /* text-red-500 */
    border: 1px solid rgba(239, 68, 68, 0.3);/* border-red-500/30 */
    padding-top: 5px;     /* Reduce top padding */
    padding-bottom: 5px;  /* Reduce bottom padding */
    padding-left: 12px;   /* Keep or adjust horizontal padding */
    padding-right: 12px;

    min-height: 14px;     /* Example: A common "thinner" button height. Adjust as needed. */
}
QPushButton[class="danger"]#stopButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(239,68,68,0.2), stop:1 rgba(225,29,72,0.2));
}
QPushButton[class="danger"]#stopButton:disabled {
    background-color: rgba(229, 231, 235, 0.5);
    color: #9ca3af;
    border-color: #e5e7eb;
}

/* "Test Flash" button */
QPushButton[class="styled"]#flashButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(59,130,246,0.1), stop:1 rgba(79,70,229,0.1)); /* from-blue-500/10 to-indigo-600/10 */
    color: #3b82f6;                           /* text-blue-500 */
    border: 1px solid rgba(59, 130, 246, 0.3);/* border-blue-500/30 */
    padding-top: 5px;     /* Reduce top padding */
    padding-bottom: 5px;  /* Reduce bottom padding */
    padding-left: 12px;   /* Keep or adjust horizontal padding */
    padding-right: 12px;

    min-height: 14px;     /* Example: A common "thinner" button height. Adjust as needed. */
}
QPushButton[class="styled"]#flashButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(59,130,246,0.2), stop:1 rgba(79,70,229,0.2));
}
/* Disabled style would be similar to action/danger if needed */


/* If you want ALL ActionButton, DangerButton, StyledButton to look like this, remove #objectName */
/* Example for all ActionButtons: */
