/* ========================================================================== */
/* Light Theme Styling - light_theme.qss                                      */
/* ========================================================================== */

/* --- Base Light Theme Global Rules --- */
QWidget[lightTheme="true"] {
    background-color: #f9fafb; /* Slightly off-white (gray-50) */
    color: #374151;            /* Dark text color (gray-700) */
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 9pt;
}
QMainWindow[lightTheme="true"] {
    background-color: #f9fafb;
    border: none;
}
QWidget#mainCentralWidget {
    background-color: #f9fafb;
    border: none;
    padding: 0px;
    margin: 0px;
}

/* --- Platform Toolbar (#platformToolbar) --- */
QToolBar#platformToolbar {
    background-color: #ffffff; /* White background */
    border: none;
    border-bottom: 1px solid #e5e7eb; /* Separator (gray-200) */
    spacing: 6px;
    padding: 4px 8px;
}

/* Logo/Title Styling */
QWidget#toolbarLogoWidget { background-color: transparent; }
QLabel#toolbarLogoIcon { background-color: transparent; }
QLabel#toolbarLogoText { background-color: transparent; color: #1f2937; font-size: 14px; font-weight: 600; padding-left: 0px; }

/* General labels in toolbar */
QToolBar#platformToolbar QLabel { color: #6b7280; background-color: transparent; }
QToolBar#platformToolbar QLabel[class="toolbarDescriptor"] { padding: 0 2px 0 5px; }
QLabel[class="toolbarSummaryLabel"] { background-color: #e5e7eb; color: #1f2937; font-weight: bold; padding: 2px 6px; border-radius: 3px; margin-right: 4px; min-width: 50px; }

/* Platform ComboBox Styling */
QToolBar#platformToolbar QComboBox#platformComboBox {
     background-color: #f9fafb; /* (gray-50) */
     color: #1f2937;
     border: 1px solid #d1d5db; /* (gray-300) */
     border-radius: 8px;
     padding: 4px 8px 4px 8px;
     min-height: 24px;
     font-weight: 500;
}
QToolBar#platformToolbar QComboBox#platformComboBox:hover { background-color: #f3f4f6; border-color: #adb5bd; }
QToolBar#platformToolbar QComboBox#platformComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 24px; border-left-width: 1px; border-left-color: #d1d5db; border-left-style: solid; border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
QToolBar#platformToolbar QComboBox#platformComboBox::down-arrow { image: url(:/icons/chevron-down.svg); width: 14px; height: 14px; }
/* Dropdown list style */
QToolBar#platformToolbar QComboBox#platformComboBox QAbstractItemView,
QComboBox QAbstractItemView {
    background-color: #ffffff; border: 1px solid #d1d5db; color: #1f2937; selection-background-color: #3b82f6; selection-color: white; padding: 4px; outline: 0px; border-radius: 4px;
}

/* Toolbar Tab Buttons Styling */
QToolBar#platformToolbar QPushButton[class="toolbarTabButton"] { background-color: transparent; color: #6b7280; border: none; border-bottom: 3px solid transparent; padding: 6px 10px; margin-left: 2px; margin-right: 2px; font-weight: 500; min-height: 22px; border-radius: 6px 6px 0 0; }
QToolBar#platformToolbar QPushButton[class="toolbarTabButton"]:hover { background-color: rgba(0, 0, 0, 0.03); color: #374151; }
QToolBar#platformToolbar QPushButton[class="toolbarTabButton"]:checked, QToolBar#platformToolbar QPushButton[class="toolbarTabButton"][activeTab="true"] { background-color: #f3f4f6; color: #2563eb; font-weight: 600; border-bottom: 3px solid #2563eb; }
QToolBar#platformToolbar QPushButton[class="toolbarTabButton"]:checked:hover, QToolBar#platformToolbar QPushButton[class="toolbarTabButton"][activeTab="true"]:hover { background-color: #e5e7eb; }

/* Theme Toggle Button Styling */
QPushButton#themeToggleButton { background-color: #f3f4f6; border: 1px solid #d1d5db; border-radius: 15px; padding: 4px; min-width: 28px; max-width: 28px; min-height: 28px; max-height: 28px; }
QPushButton#themeToggleButton:hover { background-color: #e5e7eb; }
QPushButton#themeToggleButton:pressed { background-color: #d1d5db; }


/* --- General Input Widgets (Light Theme) --- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox { background-color: #ffffff; color: #1f2937; border: 1px solid #d1d5db; border-radius: 4px; padding: 3px 6px; min-height: 18px; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: #3b82f6; background-color: #f9fafb; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled { background-color: #f3f4f6; color: #9ca3af; border-color: #e5e7eb; }
QLineEdit:read-only { background-color: #f3f4f6; color: #6b7280; border-color: #e5e7eb; }
QLineEdit[readOnly="true"] { background-color: #f3f4f6; color: #6b7280; border-color: #e5e7eb; }

/* SpinBox Arrows */
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 16px; height: 10px; border-left: 1px solid #d1d5db; border-bottom: 1px solid #d1d5db; border-top-right-radius: 4px; background-color: #f9fafb; }
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover { background-color: #f3f4f6; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/icons/chevron-up.svg); width: 10px; height: 10px; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 16px; height: 10px; border-left: 1px solid #d1d5db; border-top: 1px solid #d1d5db; border-bottom-right-radius: 4px; background-color: #f9fafb; }
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background-color: #f3f4f6; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/icons/chevron-down.svg); width: 10px; height: 10px; }

/* CheckBox */
QCheckBox { spacing: 5px; color: #374151; }
QCheckBox::indicator { width: 14px; height: 14px; border-radius: 3px; border: 1px solid #d1d5db; background-color: #ffffff; }
QCheckBox::indicator:hover { border: 1px solid #3b82f6; }
QCheckBox::indicator:checked { background-color: #3b82f6; border: 1px solid #2563eb; image: url(:/icons/check-light.svg); } /* Needs light check for blue bg */
QCheckBox::indicator:disabled { background-color: #f3f4f6; border: 1px solid #e5e7eb; }
QCheckBox:disabled { color: #9ca3af; }


/* --- Status Bar --- */
QStatusBar { background-color: #f9fafb; color: #4b5563; border-top: 1px solid #e5e7eb; font-size: 9pt; padding: 3px 8px; }
QStatusBar QLabel { padding: 1px 4px; border: none; min-height: 16px; background-color: transparent; }
QLabel#statusBarMainStatusLabel { font-weight: normal; border-radius: 4px; margin-right: 10px; }
QLabel#statusBarRegionLabel, QLabel#statusBarThresholdLabel, QLabel#statusBarDurationLabel { font-size: 9pt; color: #6b7280; margin: 0 3px; background-color: transparent; }
QLabel#statusBarRegionLabel:hover { text-decoration: underline; cursor: pointingHandCursor; }
QLabel#statusBarSeparator { color: #d1d5db; font-weight: normal; padding: 0 5px; max-width: 10px; }


/* --- Neutral Panel Class Styling --- */
QFrame[class="statusInfoCard"], QFrame[class="contentSectionPanel"], QGroupBox[class="contentSectionPanel"] { background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; }
QLabel[class="panelTitle"] { font-size: 12px; font-weight: 500; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; padding-bottom: 6px; }
QLabel[class="cardTitle"] { font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; color: #6b7280; }


/* --- Dashboard Specific Widget Styling --- */
QFrame#pnlIconFrame { background-color: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px; }
QFrame#statusIconFrame { background-color: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 8px; }
QFrame#regionIconFrame { background-color: rgba(168, 85, 247, 0.1); border: 1px solid rgba(168, 85, 247, 0.3); border-radius: 8px; }

QLabel#pnlDisplayLabel { font-size: 28px; font-weight: 700; letter-spacing: -0.025em; margin-top: 5px; }
QLabel#pnlDisplayLabel[state="positive"] { color: #10b981; } /* (green-500) */
QLabel#pnlDisplayLabel[state="negative"] { color: #ef4444; } /* (red-500) */
QLabel#pnlDisplayLabel[state="neutral"]  { color: #6b7280; } /* (gray-500) */

QLabel#monitoringStatusLabel { font-size: 28px; font-weight: 700; letter-spacing: -0.025em; margin-top: 5px; }
QLabel#monitoringStatusLabel[state="active"]   { color: #3b82f6; } /* (blue-500) */
QLabel#monitoringStatusLabel[state="inactive"] { color: #6b7280; }
QLabel#monitoringStatusLabel[state="error"]    { color: #ef4444; }
QLabel#monitoringStatusLabel[state="busy"]     { color: #f59e0b; } /* (amber-500) */

QLabel#regionNameLabel { font-size: 28px; font-weight: 700; color: #8b5cf6; letter-spacing: -0.025em; margin-top: 5px; }
QLabel#regionPositionLabel { font-size: 12px; color: #6b7280; margin-top: 2px; }

QFrame#pnlChartPlaceholder { background-color: transparent; border: none; border-radius: 2px; }
QLabel#graphPlaceholder { background-color: transparent; border: none; border-radius: 6px; font-style: italic; color: #6b7280; padding: 0px; text-align: center; }

QProgressBar#monitoringProgress, QProgressBar#vsCalibrationProgress { background-color: #e5e7eb; border: none; border-radius: 9999px; height: 8px; text-align: center; color: #4b5563; font-size: 7pt; }
QProgressBar#monitoringProgress::chunk, QProgressBar#vsCalibrationProgress::chunk { background-color: #3b82f6; border-radius: 9999px; }

QLabel#prereqBadge, QLabel#vsMonitorStatusBadge, QLabel#vsFlattenCountBadge { background-color: #f3f4f6; color: #4b5563; border-radius: 6px; padding: 4px 10px; font-size: 10px; font-weight: 500; }
QLabel#alertsBadge { background-color: rgba(220, 38, 38, 0.1); color: #ef4444; border: 1px solid rgba(220, 38, 38, 0.3); border-radius: 6px; padding: 4px 10px; font-size: 10px; font-weight: 500; }

QFrame#panelDivider { background-color: #e5e7eb; max-height: 1px; min-height: 1px; border: none; }

QFrame[objectName^="prereqRow_"] { border-radius: 6px; }
QFrame[objectName^="prereqRow_"]:hover { background-color: rgba(229, 231, 235, 0.6); }
QLabel[objectName^="prereqIcon_"] { background-color: transparent; }
QLabel[objectName^="prereqText_"] { font-size: 12px; color: #4b5563; background-color: transparent; }

/* Dashboard Quick Action Button Specific Styling */
QPushButton#startButton { padding-top: 5px; padding-bottom: 5px; padding-left: 12px; padding-right: 12px; min-height: 14px; }
QPushButton#stopButton { padding-top: 5px; padding-bottom: 5px; padding-left: 12px; padding-right: 12px; min-height: 14px; }
QPushButton#flashButton { padding-top: 5px; padding-bottom: 5px; padding-left: 12px; padding-right: 12px; min-height: 14px; }

/* --- General Button Class Styling --- */
QPushButton[class="action"], QPushButton[class="danger"], QPushButton[class="styled"],
QPushButton[class="warning"], QPushButton[class="secondary"] { border-radius: 8px; font-weight: 500; font-size: 12px; padding: 6px 12px; min-height: 14px; }
/* ActionButton */
QPushButton[class="action"] { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(34,197,94,0.1), stop:1 rgba(5,150,105,0.1)); color: #059669; border: 1px solid rgba(34, 197, 94, 0.3); }
QPushButton[class="action"]:hover { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(34,197,94,0.2), stop:1 rgba(5,150,105,0.2)); }
QPushButton[class="action"]:pressed { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(34,197,94,0.3), stop:1 rgba(5,150,105,0.3)); }
QPushButton[class="action"]:disabled { background-color: rgba(229, 231, 235, 0.5); color: #9ca3af; border-color: #e5e7eb; }
/* DangerButton */
QPushButton[class="danger"] { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(239,68,68,0.1), stop:1 rgba(225,29,72,0.1)); color: #dc2626; border: 1px solid rgba(239, 68, 68, 0.3); }
QPushButton[class="danger"]:hover { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(239,68,68,0.2), stop:1 rgba(225,29,72,0.2)); }
QPushButton[class="danger"]:pressed { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(239,68,68,0.3), stop:1 rgba(225,29,72,0.3)); }
QPushButton[class="danger"]:disabled { background-color: rgba(229, 231, 235, 0.5); color: #9ca3af; border-color: #e5e7eb; }
/* StyledButton (Primary/Blue) */
QPushButton[class="styled"] { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(59,130,246,0.1), stop:1 rgba(79,70,229,0.1)); color: #2563eb; border: 1px solid rgba(59, 130, 246, 0.3); }
QPushButton[class="styled"]:hover { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(59,130,246,0.2), stop:1 rgba(79,70,229,0.2)); }
QPushButton[class="styled"]:pressed { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(59,130,246,0.3), stop:1 rgba(79,70,229,0.3)); }
QPushButton[class="styled"]:disabled { background-color: rgba(229, 231, 235, 0.5); color: #9ca3af; border-color: #e5e7eb; }
/* WarningButton */
QPushButton[class="warning"] { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(245,158,11,0.1), stop:1 rgba(217,119,6,0.1)); color: #d97706; border: 1px solid rgba(245, 158, 11, 0.3); }
QPushButton[class="warning"]:hover { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(245,158,11,0.2), stop:1 rgba(217,119,6,0.2)); }
QPushButton[class="warning"]:pressed { background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(245,158,11,0.3), stop:1 rgba(217,119,6,0.3)); }
QPushButton[class="warning"]:disabled { background-color: rgba(229, 231, 235, 0.5); color: #9ca3af; border-color: #e5e7eb; }
/* SecondaryButton */
QPushButton[class="secondary"] { background-color: rgba(243, 244, 246, 0.8); color: #4b5563; border: 1px solid rgba(209, 213, 219, 0.7); }
QPushButton[class="secondary"]:hover { background-color: rgba(229, 231, 235, 0.9); border-color: rgba(156, 163, 175, 0.8); }
QPushButton[class="secondary"]:pressed { background-color: rgba(209, 213, 219, 0.9); }
QPushButton[class="secondary"]:disabled { background-color: rgba(243, 244, 246, 0.5); color: #9ca3af; border-color: #e5e7eb; }
/* IconButton */
QPushButton[class="iconButtonBare"] { background-color: transparent; border: 1px solid transparent; padding: 4px; border-radius: 4px; }
QPushButton[class="iconButtonBare"]:hover { background-color: rgba(0, 0, 0, 0.05); border-color: rgba(0, 0, 0, 0.1); }
QPushButton[class="iconButtonBare"]:pressed { background-color: rgba(0, 0, 0, 0.1); }
/* Fallback QPushButton */
QPushButton { border: 1px solid #d1d5db; border-radius: 4px; padding: 4px 12px; min-height: 14px; background-color: #f9fafb; color: #1f2937; font-weight: normal; }
QPushButton:hover { background-color: #f3f4f6; }
QPushButton:pressed { background-color: #e5e7eb; }
QPushButton:disabled { background-color: #f3f4f6; color: #9ca3af; border-color: #e5e7eb; }


/* Alerts List & Flatten List*/
QListWidget#alertsList, QListWidget#vsFlattenListWidget { background-color: transparent; border: none; border-radius: 0px; }
QListWidget#alertsList::item, QListWidget#vsFlattenListWidget::item { padding: 2px; border: none; background-color: transparent; }
QListWidget#alertsList::item[alertType="error"] { background-color: rgba(220, 38, 38, 0.05); border: 1px solid rgba(220, 38, 38, 0.3); border-radius: 8px; }
QListWidget#alertsList::item[alertType="warning"] { background-color: rgba(245, 158, 11, 0.05); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 8px; }
QListWidget#alertsList::item[alertType="success"] { background-color: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px; }
QListWidget#alertsList::item[alertType="info"] { background-color: rgba(59, 130, 246, 0.05); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 8px; }
QListWidget#alertsList::item:selected { background-color: #3b82f6; color: white; border-color: #1d4ed8; }
QListWidget#alertsList::item:hover { background-color: rgba(0, 0, 0, 0.02); }


/* Log Display */
QTextEdit#logDisplay { background-color: #ffffff; color: #6b7280; border: 1px solid #e5e7eb; border-radius: 6px; font-family: "Consolas", "Menlo", "Courier New", monospace; font-size: 11px; padding: 8px; }

/* Settings View Specifics */
QLabel#verifyStatusLabel { font-weight: bold; padding: 3px 6px; border-radius: 4px; }
QLabel#verifyStatusLabel[state="verified"] { background-color: #dcfce7; color: #166534; } /* green-100 bg, green-800 text */
QLabel#verifyStatusLabel[state="error"] { background-color: #fee2e2; color: #991b1b; } /* red-100 bg, red-800 text */
QLabel#verifyStatusLabel[state="pending"], QLabel#verifyStatusLabel[state="verifying"] { background-color: #ffedd5; color: #9a3412; } /* orange-100 bg, orange-800 text */
QLabel#platformDisplayLabel { font-weight: bold; color: #374151; }
QLabel#dataDirLabel { color: #6b7280; }


/* Visual Setup Specifics */
QLabel#vsMonitorPreviewLabel { background-color: #f3f4f6; border: 1px dashed #d1d5db; color: #9ca3af; border-radius: 4px; }
QLabel#vsMonitorCoordsLabel { color: #6b7280; font-size: 8pt; }
QLabel#vsOcrSourceStatusLabel { font-style: italic; color: #6b7280; }
QLabel#vsCalibrationStatusLabel { color: #6b7280; }
QLabel#vsCalibrationStatusLabel[state="success"] { color: #10b981; }
QLabel#vsCalibrationStatusLabel[state="error"] { color: #ef4444; }
QLabel#vsCalibrationStatusLabel[state="busy"] { color: #f59e0b; }
QLabel#vsCalibrationStatusLabel[state="info"] { color: #6b7280; }

/* Region Entry Widget Styling */
QFrame#regionEntryContainer { background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 6px; }
QWidget#regionEntryHeader { background-color: #f9fafb; border-bottom: 1px solid #e5e7eb; }
QLabel#regionEntryName { color: #1f2937; font-weight: bold; }
QLabel#regionEntryCoords { color: #6b7280; font-size: 8pt; }
QWidget#previewContainer { background-color: transparent; }
QLabel#regionEntryPreview { background-color: #f3f4f6; border: 1px solid #e5e7eb; color: #9ca3af; }
QWidget#actionsContainer { background-color: transparent; }

/* History View Specifics */
QTableWidget#historyTable { background-color: #ffffff; border: 1px solid #e5e7eb; color: #374151; gridline-color: #e5e7eb; border-radius: 6px; }
QTableWidget#historyTable::item { padding: 4px; border-bottom: 1px solid #f3f4f6; }
QTableWidget#historyTable::item:selected { background-color: #dbeafe; color: #1e40af; } /* blue-100 bg, blue-800 text */
QHeaderView::section { background-color: #f9fafb; color: #6b7280; padding: 4px; border: 1px solid #e5e7eb; font-weight: bold; }


/* --- Scrollbars --- */
QScrollBar:vertical { border: none; background: #f3f4f6; width: 8px; margin: 0px; }
QScrollBar::handle:vertical { background: #d1d5db; min-height: 25px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; border: none; background: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QScrollBar:horizontal { border: none; background: #f3f4f6; height: 8px; margin: 0px; }
QScrollBar::handle:horizontal { background: #d1d5db; min-width: 25px; border-radius: 4px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; border: none; background: none; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* --- Splitter --- */
QSplitter::handle { background-color: #e5e7eb; }
QSplitter::handle:horizontal { width: 5px; }
QSplitter::handle:vertical   { height: 5px; }

/* --- Tooltip --- */
QToolTip { border: 1px solid #d1d5db; background-color: #ffffff; color: #1f2937; padding: 4px; border-radius: 4px; }

/* --- GroupBox --- */
QGroupBox, GroupHeader { font-weight: 500; background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 8px; color: #374151; margin-top: 15px; padding: 1px; }
QGroupBox::title, GroupHeader::title { subcontrol-origin: margin; subcontrol-position: top left; left: 15px; padding: 2px 8px; margin-top: -8px; background-color: #f9fafb; color: #6b7280; font-size: 12px; font-weight: 600; border-radius: 4px; }
QGroupBox::indicator, GroupHeader::indicator { width: 16px; height: 16px; margin-left: 8px; subcontrol-origin: margin; subcontrol-position: top right; right: 10px; top: 3px; }
QGroupBox::indicator:unchecked, GroupHeader::indicator:unchecked { image: url(:/icons/chevron-right.svg); } /* Needs dark icon */
QGroupBox::indicator:checked, GroupHeader::indicator:checked { image: url(:/icons/chevron-down.svg); } /* Needs dark icon */
QGroupBox[class="contentSectionPanel"] { padding: 1px; }