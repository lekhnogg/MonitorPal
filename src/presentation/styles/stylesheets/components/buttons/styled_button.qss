/* src/presentation/styles/stylesheets/components/buttons/styled_button.qss */
QPushButton {
    background-color: #3498db;
    color: white;
    border-radius: 4px;
    padding: 5px 10px;
    font-weight: bold;
    min-height: 25px;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:pressed {
    background-color: #1c6ea4;
}

QPushButton:disabled {
    background-color: #bdc3c7;
    color: #7f8c8d;
}